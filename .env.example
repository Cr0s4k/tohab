# Host binding for the web (nginx + PWA) port. Use `127.0.0.1:8080` to stay on
# loopback, or a private address such as `<tailscale-ip>:8080` to expose on Tailscale.
WEB_PORT=127.0.0.1:8080

POSTGRES_USER=tohab
POSTGRES_DB=tohab
POSTGRES_PORT=127.0.0.1:5432

# Directory holding the `postgres_password` secret file (mode 0600). Local dev can
# point this at `./secrets`; the homelab renders it to `/etc/komodo/secrets/tohab`
# from SOPS via Ansible.
TOHAB_SECRETS_DIR=./secrets

# Signs calendar feed URLs. Optional: one is generated and stored in Postgres on first use.
# Set it to keep feed URLs identical across a database reset.
CALENDAR_SECRET=

# Optional public base used when calendar clients cannot reach the private app origin.
# Include the /calendar path, for example https://calendar.example.com/calendar.
CALENDAR_PUBLIC_BASE_URL=

# Days to retain cancellation events in the polling calendar feed.
CALENDAR_TOMBSTONE_RETENTION_DAYS=90

# Contact identity included in Web Push VAPID tokens. Use a real mailto: address or
# HTTPS URL. Apple Push rejects localhost and .local identities with 403 BadJwtToken.
VAPID_SUBJECT=https://tohab.example.com

# Only needed when the app is served from a different origin than the sync server.
# Comma-separated; the session cookie cannot be sent to a wildcard origin.
ALLOWED_ORIGINS=
