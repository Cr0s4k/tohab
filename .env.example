WEB_PORT=8080

POSTGRES_USER=tohab
POSTGRES_PASSWORD=tohab
POSTGRES_DB=tohab
POSTGRES_PORT=5432

# Signs calendar feed URLs. Optional: one is generated and stored in Postgres on first use.
# Set it to keep feed URLs identical across a database reset.
CALENDAR_SECRET=

# Only needed when the app is served from a different origin than the sync server.
# Comma-separated; the session cookie cannot be sent to a wildcard origin.
ALLOWED_ORIGINS=
